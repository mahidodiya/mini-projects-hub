{
  "name": "campus-clubhub",
  "version": "2.0.0",
  "description": "Campus ClubHub — student club & society platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:reset": "node db/reset.js",
    "db:setup": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "images": "node scripts/generate-images.js",
    "setup": "npm run images && npm run db:setup && npm run db:seed"
  },
  "keywords": ["campus", "clubs", "express", "postgres"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
